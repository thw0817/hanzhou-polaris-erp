{
  "name": "shein-operations-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/dev.js",
    "dev:local:direct": "env SHEIN_LOCAL_DIRECT_AUTH=true node --env-file-if-exists=.env server/dev.js",
    "dev:web": "vite --mode web",
    "dev:v2": "vite --mode v2 --port 5174",
    "dev:v2:local": "node server/dev-v2.js",
    "dev:v2:real-local": "node --env-file-if-exists=.env server/dev-v2-real-local.js",
    "dev:v2:real": "VITE_V2_API_TARGET=https://app.hanzhou.icu vite --mode v2 --port 5173",
    "api": "node --env-file-if-exists=.env server/index.js",
    "cloud:control": "node --env-file-if-exists=.env server/cloud/control-server.js",
    "cloud:provision-device": "node --env-file-if-exists=.env server/cloud/provision-device.js",
    "cloud:provision-web-user": "node --env-file-if-exists=.env server/cloud/provision-web-user.js",
    "demo:web-api": "node server/cloud/web-demo-server.js",
    "media-cleanup:cloud": "node --env-file-if-exists=.env server/cloud/media-cleanup-worker-server.js",
    "store-business-refresh-worker:cloud": "node --env-file-if-exists=.env server/cloud/store-business-refresh-worker-server.js",
    "rule-refresh-worker:cloud": "node --env-file-if-exists=.env server/cloud/rule-refresh-worker-server.js",
    "compliance-sync-worker:cloud": "node --env-file-if-exists=.env server/cloud/compliance-sync-worker-server.js",
    "product-publish-worker:cloud": "node --env-file-if-exists=.env server/cloud/product-publish-worker-server.js",
    "db:rehearse:028": "node --env-file-if-exists=.env server/cloud/rehearse-compliance-review-migration.js",
    "db:rehearse:029": "node --env-file-if-exists=.env server/cloud/rehearse-compliance-audit-immutability-migration.js",
    "db:audit:runtime-role": "node --env-file-if-exists=.env server/cloud/audit-runtime-database-role.js",
    "db:audit:v2-readiness": "node --env-file-if-exists=.env server/cloud/audit-v2-release-readiness.js",
    "release:audit:v2": "node server/cloud/audit-v2-release-readiness.js --static-only",
    "db:capabilities:write": "node server/cloud/runtime-database-capabilities.js --write",
    "webhook:cloud": "node --env-file-if-exists=.env server/cloud/webhook-server.js",
    "webhook-worker:cloud": "node --env-file-if-exists=.env server/cloud/webhook-worker-server.js",
    "db:migrate": "node --env-file-if-exists=.env server/cloud/migrate.js",
    "build": "npm run build:v2",
    "build:web": "npm run build:v2",
    "build:v2": "tsc -p tsconfig.v2.json --noEmit && vite build --mode v2",
    "test": "node --test",
    "preview": "vite preview --outDir dist-v2",
    "preview:v2": "vite preview --outDir dist-v2"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.10",
    "bullmq": "^5.81.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.7",
    "react-router": "7.18.2",
    "read-excel-file": "^9.3.5",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^6.0.5"
  }
}
