# Local-only staging template. Never place production credentials here.
SHEIN_RUNTIME_MODE=cloud
SHEIN_ENVIRONMENT=staging
SHEIN_APP_ID=
SHEIN_APP_SECRET=
SHEIN_API_BASE_URL=http://shein-api-disabled.invalid
SHEIN_AUTHORIZATION_HOST=authorization-disabled.invalid
SHEIN_DESKTOP_REDIRECT_URL=http://127.0.0.1:8870/api/shein/auth/callback
SHEIN_WEB_AUTHORIZATION_REDIRECT_URL=http://127.0.0.1:4174/v1/web/shein/auth/callback
SHEIN_WEB_APP_BASE_URL=http://127.0.0.1:4174
SHEIN_CLOUD_CONTROL_HOST=0.0.0.0
SHEIN_CLOUD_CONTROL_PORT=8870
SHEIN_CLOUD_ALLOWED_ORIGINS=http://127.0.0.1:4174
SHEIN_WEB_COOKIE_NAME=polaris_staging_session
SHEIN_WEB_COOKIE_SECURE=false
SHEIN_WEB_SHEIN_MODULE_ENABLED=false

# Staging-only data services. These names and ports are intentionally not the production values.
SHEIN_RUNTIME_DATABASE_URL=postgres://shein:staging-only@postgres:5432/polaris_staging
SHEIN_MIGRATION_DATABASE_URL=postgres://shein:staging-only@postgres:5432/polaris_staging
DATABASE_URL=postgres://shein:staging-only@127.0.0.1:55432/polaris_staging
REDIS_URL=redis://127.0.0.1:56379
SHEIN_CLOUD_ENCRYPTION_KEY=c3RhZ2luZy1vbmx5LWtleS1ub3QtYS1wcm9kLXNlY3JldC0xMjM0NTY=

# All external write/sync capabilities remain fail-closed in staging.
SHEIN_PRODUCT_PUBLISH_EXECUTION_ENABLED=false
SHEIN_COMPLIANCE_WRITES_ENABLED=false
SHEIN_WEBHOOK_INGRESS_ENABLED=false
SHEIN_STORE_BUSINESS_REFRESH_ENABLED=false
SHEIN_RULE_REFRESH_ENABLED=false
SHEIN_COMPLIANCE_SYNC_ENABLED=false

# Independent S3-compatible bucket. MinIO is local to the staging Compose project.
SHEIN_MEDIA_STORAGE_PROVIDER=s3
SHEIN_MEDIA_S3_ENDPOINT=http://minio:9000
SHEIN_MEDIA_S3_REGION=us-east-1
SHEIN_MEDIA_S3_BUCKET=shein-polaris-staging
SHEIN_MEDIA_S3_ACCESS_KEY_ID=staging-access
SHEIN_MEDIA_S3_SECRET_ACCESS_KEY=staging-secret
SHEIN_MEDIA_MAX_UPLOAD_BYTES=20971520
