# Copying this file is optional. Never commit real credentials.
SHEIN_APP_ID=
SHEIN_APP_SECRET=

# Full-managed production defaults from the SHEIN documentation.
SHEIN_API_BASE_URL=https://openapi.sheincorp.cn
SHEIN_AUTHORIZATION_HOST=openapi-sem.sheincorp.com
SHEIN_REDIRECT_URL=http://127.0.0.1:5173/
SHEIN_ENVIRONMENT=production-full-managed
SHEIN_RUNTIME_MODE=local
# Set true for local real-browser authorization and direct read-only sync.
# Credentials stay in the local encrypted vault; publishing remains disabled.
SHEIN_LOCAL_DIRECT_AUTH=false
SHEIN_CLOUD_API_BASE_URL=https://api.hanzhou.icu
# V2 defaults to the local demo API. Point this at a local cloud-control
# proxy only after its database, Redis and authorization modules are ready.
VITE_V2_API_TARGET=http://127.0.0.1:8790
SHEIN_CLOUD_SESSION_FILE=.data/cloud-session.v1.json

# Optional AI title assistant. Configure an OpenAI-compatible visual endpoint;
# model/model URL are runtime values so the provider is not hard-coded.
SHEIN_TITLE_AI_API_URL=
SHEIN_TITLE_AI_API_KEY=
SHEIN_TITLE_AI_MODEL=
SHEIN_TITLE_AI_MODEL_URL=
SHEIN_TITLE_AI_TIMEOUT_MS=30000
SHEIN_TITLE_AI_MAX_CONCURRENT=2
SHEIN_CREDENTIAL_FILE=.data/shein-stores.v1.json
SHEIN_CREDENTIAL_KEY_FILE=.data/shein-stores.v2.key
SHEIN_TEMPLATE_FILE=.data/shein-templates.v1.json
SHEIN_BUSINESS_DATA_FILE=.data/shein-business-data.v1.json

# Optional: bootstrap one already-authorized store for a direct read-only test.
# SHEIN_STORE_SECRET_KEY must be the decrypted store secret.
SHEIN_STORE_OPEN_KEY_ID=
SHEIN_STORE_SECRET_KEY=
SHEIN_STORE_SUPPLIER_ID=
SHEIN_STORE_LABEL=

# Optional cloud mode. Local mode does not connect to PostgreSQL or Redis.
DATABASE_URL=
# Optional dedicated owner connection for the migration CLI.
SHEIN_MIGRATION_DATABASE_URL=
REDIS_URL=

# 32-byte base64 master key used to encrypt store credentials in cloud mode.
# Generate once and keep it outside source control.
SHEIN_CLOUD_ENCRYPTION_KEY=

# Cloud-only official Webhook receiver. Keep disabled on desktop/local installs.
SHEIN_WEBHOOK_INGRESS_ENABLED=false
SHEIN_WEBHOOK_VERIFICATION_MODE=shein-direct
SHEIN_WEBHOOK_HOST=127.0.0.1
SHEIN_WEBHOOK_PORT=8791
SHEIN_WEBHOOK_MAX_CLOCK_SKEW_MS=300000

# Compliance writes stay disabled unless both values are explicitly configured.
SHEIN_COMPLIANCE_WRITES_ENABLED=false
SHEIN_COMPLIANCE_CONFIRMATION_SECRET=

# Optional cloud web registration/password-reset email via SMTP.
# Use an authorization code, never the mailbox login password.
SHEIN_EMAIL_PROVIDER=resend
SHEIN_EMAIL_FROM=
SHEIN_EMAIL_REPLY_TO=
SHEIN_SMTP_HOST=smtp.163.com
SHEIN_SMTP_PORT=465
SHEIN_SMTP_SECURE=true
SHEIN_SMTP_USER=
SHEIN_SMTP_PASSWORD=
