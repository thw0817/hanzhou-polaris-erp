# Cloud worker/API example. Never commit real credentials.
SHEIN_RUNTIME_MODE=cloud
SHEIN_APP_ID=
SHEIN_APP_SECRET=
SHEIN_API_BASE_URL=https://openapi.sheincorp.cn
SHEIN_AUTHORIZATION_HOST=openapi-sem.sheincorp.com
SHEIN_REDIRECT_URL=https://your-domain.example/authorization/callback
SHEIN_DESKTOP_REDIRECT_URL=http://127.0.0.1:8787/api/shein/auth/callback
SHEIN_WEB_AUTHORIZATION_REDIRECT_URL=https://app.hanzhou.icu/v1/web/shein/auth/callback
SHEIN_WEB_APP_BASE_URL=https://app.hanzhou.icu
# Public registration joins this single active workspace as an operator with no
# store access. Leave empty only when exactly one active tenant exists.
SHEIN_PUBLIC_REGISTRATION_TENANT_ID=
# Password reset email. Resend requires a verified sender domain/address.
SHEIN_EMAIL_PROVIDER=resend
SHEIN_EMAIL_API_KEY=
SHEIN_EMAIL_FROM=
SHEIN_EMAIL_REPLY_TO=
SHEIN_SMTP_HOST=smtp.163.com
SHEIN_SMTP_PORT=465
SHEIN_SMTP_SECURE=true
SHEIN_SMTP_USER=
SHEIN_SMTP_PASSWORD=

# Compose inputs. Provision the runtime role separately and verify it with
# deploy/postgres/audit-runtime-role.sql before starting long-running services.
SHEIN_RUNTIME_DATABASE_URL=postgres://shein_runtime:change-me@postgres:5432/shein_console
SHEIN_MIGRATION_DATABASE_URL=postgres://shein:change-me@postgres:5432/shein_console
# Direct non-Compose Node commands continue to accept DATABASE_URL.
DATABASE_URL=postgres://shein_runtime:change-me@127.0.0.1:5432/shein_console
REDIS_URL=redis://127.0.0.1:6379
SHEIN_CLOUD_ENCRYPTION_KEY=
SHEIN_CLOUD_CONTROL_HOST=127.0.0.1
SHEIN_CLOUD_CONTROL_PORT=8790
# Comma-separated browser origins. Desktop clients do not require CORS.
SHEIN_CLOUD_ALLOWED_ORIGINS=https://app.hanzhou.icu,http://127.0.0.1:5173,http://localhost:5173
SHEIN_WEB_COOKIE_NAME=shein_web_session
SHEIN_WEB_COOKIE_SECURE=true
SHEIN_WEB_SHEIN_MODULE_ENABLED=false

# AI标题助手。只在服务端保存密钥；API地址和模型标识/地址均可更换，不写死具体模型。
SHEIN_TITLE_AI_API_URL=
SHEIN_TITLE_AI_API_KEY=
SHEIN_TITLE_AI_MODEL=
SHEIN_TITLE_AI_MODEL_URL=
SHEIN_TITLE_AI_TIMEOUT_MS=30000
SHEIN_TITLE_AI_MAX_CONCURRENT=2

# Read-only store business refresh worker. Keep concurrency low because one
# store refresh already performs paginated SHEIN requests.
SHEIN_STORE_BUSINESS_REFRESH_ENABLED=false
SHEIN_STORE_BUSINESS_REFRESH_CONCURRENCY=1
# Also requires SHEIN_STORE_BUSINESS_REFRESH_ENABLED=true. Each interval is
# both the scan frequency and the minimum age of a snapshot selected for refresh.
SHEIN_STORE_BUSINESS_SCHEDULER_ENABLED=false
SHEIN_STORE_BUSINESS_SCHEDULE_INTERVAL_MS=900000

# Read-only category and publish schema refresh. The API only enqueues when enabled.
SHEIN_RULE_REFRESH_ENABLED=false
SHEIN_RULE_REFRESH_CONCURRENCY=1
SHEIN_RULE_REFRESH_TARGET_CONCURRENCY=4
# Optional monthly full refresh. Default: day 1, 03:00-04:00 Asia/Shanghai.
# Set the day to 1-31; a day not present in a month is skipped for that month.
SHEIN_RULE_REFRESH_SCHEDULE_ENABLED=false
SHEIN_RULE_REFRESH_SCHEDULE_INTERVAL_MS=60000
SHEIN_RULE_REFRESH_SCHEDULE_DAY=1
SHEIN_RULE_REFRESH_SCHEDULE_START_HOUR=3
SHEIN_RULE_REFRESH_SCHEDULE_END_HOUR=4
SHEIN_RULE_REFRESH_SCHEDULE_TIME_ZONE=Asia/Shanghai

# Read-only SKC compliance requirement sync. Missing source coverage is failed,
# never treated as passed. Keep disabled until the worker is verified.
SHEIN_COMPLIANCE_SYNC_ENABLED=false
SHEIN_COMPLIANCE_SYNC_CONCURRENCY=1

# Real SHEIN product creation. Keep false until migration 034, runtime-role
# capabilities, the control action, worker and one-product readback drill pass.
# Each queue delivery is single-attempt; unknown results are never auto-retried.
SHEIN_PRODUCT_PUBLISH_EXECUTION_ENABLED=false
SHEIN_PRODUCT_PUBLISH_CONCURRENCY=1
# Durable publish-command delivery. Keep false until the full ERP-06 gate passes;
# the publish worker refuses to start without this companion switch.
SHEIN_OUTBOX_DISPATCHER_ENABLED=false
SHEIN_OUTBOX_DISPATCHER_BATCH_SIZE=50
SHEIN_OUTBOX_DISPATCHER_LEASE_SECONDS=60
SHEIN_OUTBOX_DISPATCHER_POLL_INTERVAL_MS=1000

# Private S3-compatible object storage. The endpoint should already include
# the bucket hostname, for example https://bucket-name.cos.ap-hongkong.myqcloud.com
SHEIN_MEDIA_STORAGE_PROVIDER=s3
SHEIN_MEDIA_S3_ENDPOINT=
SHEIN_MEDIA_S3_REGION=ap-hongkong
SHEIN_MEDIA_S3_BUCKET=
SHEIN_MEDIA_S3_ACCESS_KEY_ID=
SHEIN_MEDIA_S3_SECRET_ACCESS_KEY=
SHEIN_MEDIA_MAX_UPLOAD_BYTES=20971520
SHEIN_MEDIA_CLEANUP_INTERVAL_MS=60000
SHEIN_MEDIA_CLEANUP_BATCH_SIZE=100

# Local-first workspace guardrails. These are active素材/草稿 limits per store
# and per account; publishing a draft releases its private creative media.
SHEIN_DRAFT_LIMIT_PER_STORE=100
SHEIN_DRAFT_LIMIT_PER_ACCOUNT=1000
SHEIN_MEDIA_LIMIT_PER_STORE=1000
SHEIN_MEDIA_LIMIT_PER_ACCOUNT=10000
SHEIN_MEDIA_BYTES_LIMIT_PER_STORE=4294967296
SHEIN_MEDIA_BYTES_LIMIT_PER_ACCOUNT=42949672960

# Enable only after the HTTPS routes are deployed and tested.
SHEIN_WEBHOOK_INGRESS_ENABLED=false
SHEIN_WEBHOOK_VERIFICATION_MODE=shein-direct
SHEIN_WEBHOOK_HOST=127.0.0.1
SHEIN_WEBHOOK_PORT=8791
# Five-minute timestamp window; duplicate signatures are held in Redis.
SHEIN_WEBHOOK_MAX_CLOCK_SKEW_MS=300000
